      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/PawnKindDef[defName="OPAE_WolfeinAIPT_HysteriaShambler"]/label</xpath>
          <value>
            <label>hysteria shambler</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>