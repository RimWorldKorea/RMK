<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>##packageId##vanillaexpanded.gravship</li>
      <li>##packageId##vanillaexpanded.gravship_steam</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="DMSE_FuelSiloTank"]/label</xpath>
          <value>
            <label>아스트로연료 사일로</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="DMSE_FuelTankSmall"]/label</xpath>
          <value>
            <label>소형 아스트로연료 사일로</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>