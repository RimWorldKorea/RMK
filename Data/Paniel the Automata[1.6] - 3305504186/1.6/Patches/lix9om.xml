<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/FactionDef[defName="PN_SubsidiaryFaction"]/royalFavorLabel</xpath>
          <value>
            <royalFavorLabel>PnL 성과 포인트</royalFavorLabel>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>